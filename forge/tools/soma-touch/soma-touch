#!/usr/bin/env python3
"""soma-touch: sign in to Soma (and unlock its shell) with the laptop's fingerprint reader, in any browser.

Browsers on Linux can't use a laptop's fingerprint reader for passkeys, so Soma's "fingerprint" went through Bitwarden
and three clicks (2026-10-27). This helper listens on 127.0.0.1 only. A Soma page asks Soma for a one-time challenge,
hands it here, the helper waits for a finger on the reader (fprintd-verify), and answers the challenge with this
laptop's device key (enrolled in Soma like the phone app). The page sends the answer to Soma, which opens the session.
Only Soma's own pages can read the answer (CORS); a finger is needed every time; the key never leaves this file:
~/.config/soma-touch/device.json (mode 600).

  soma-touch serve      the helper (a systemd user service runs it)
  soma-touch install    start it with the desktop (once)
"""
import base64, hashlib, hmac, http.server, json, os, subprocess, sys, threading

PORT = 47811
KEY = os.path.expanduser("~/.config/soma-touch/device.json")
ORIGINS = {"https://soma.meldev.duckdns.org", "https://192.168.10.20:8443", "https://100.64.0.4:8443",
           "https://homelab.tail139096.ts.net", "http://192.168.10.20:8443"}
LOCK = threading.Lock()


def dev():
    return json.load(open(KEY))


class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def cors(self):
        o = self.headers.get("Origin", "")
        if o in ORIGINS:
            self.send_header("Access-Control-Allow-Origin", o)
            self.send_header("Access-Control-Allow-Headers", "Content-Type")
            self.send_header("Access-Control-Allow-Private-Network", "true")   # Chrome's check for pages calling localhost
            self.send_header("Vary", "Origin")

    def reply(self, code, obj):
        b = json.dumps(obj).encode()
        self.send_response(code); self.cors(); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)

    def do_OPTIONS(self):
        self.send_response(204); self.cors(); self.send_header("Access-Control-Allow-Methods", "GET, POST"); self.end_headers()

    def do_GET(self):
        if self.path != "/ping": return self.reply(404, {"ok": False})
        try: return self.reply(200, {"ok": True, "id": dev()["id"]})
        except (OSError, ValueError, KeyError): return self.reply(503, {"ok": False, "error": "not enrolled"})

    def do_POST(self):
        if self.headers.get("Origin", "") not in ORIGINS: return self.reply(403, {"ok": False})
        if self.path == "/enroll":   # once: Soma made this laptop's device key (after the password) and hands it here
            try:
                b = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 4096)) or b"{}")
                d = {"id": str(b["id"]), "secret": str(b["secret"])}; base64.b64decode(d["secret"])
            except (ValueError, KeyError): return self.reply(400, {"ok": False})
            os.makedirs(os.path.dirname(KEY), exist_ok=True)
            with open(os.open(KEY, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f: json.dump(d, f)
            return self.reply(200, {"ok": True})
        if self.path != "/sign": return self.reply(404, {"ok": False})
        try:
            b = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 4096)) or b"{}")
            nonce, purpose = str(b["nonce"]), "elevate" if b.get("purpose") == "elevate" else "signin"
        except (ValueError, KeyError): return self.reply(400, {"ok": False})
        if not LOCK.acquire(blocking=False): return self.reply(409, {"ok": False, "error": "Already waiting for a finger."})
        try:   # the finger: fprintd-verify exits 0 on a match (it gives up after a few tries or ~30 s)
            r = subprocess.run(["fprintd-verify", os.environ.get("USER", "moosa")], capture_output=True, text=True, timeout=40)
            if r.returncode != 0 or "verify-match" not in r.stdout:
                return self.reply(401, {"ok": False, "error": "That finger didn't match." if "no-match" in r.stdout else "No finger read."})
        except subprocess.TimeoutExpired: return self.reply(401, {"ok": False, "error": "No finger read."})
        finally: LOCK.release()
        d = dev()
        mac = hmac.new(base64.b64decode(d["secret"]), f"{nonce}:{purpose}".encode(), hashlib.sha256).hexdigest()
        return self.reply(200, {"ok": True, "id": d["id"], "nonce": nonce, "purpose": purpose, "mac": mac})


def install():
    """The helper as a systemd user service that starts with the desktop."""
    u = os.path.expanduser("~/.config/systemd/user"); os.makedirs(u, exist_ok=True)
    open(f"{u}/soma-touch.service", "w").write(f"[Unit]\nDescription=soma-touch: Soma sign-in with the fingerprint reader\n"
        f"[Service]\nExecStart={os.path.realpath(__file__)} serve\nRestart=on-failure\n[Install]\nWantedBy=default.target\n")
    subprocess.run(["systemctl", "--user", "daemon-reload"]); subprocess.run(["systemctl", "--user", "enable", "--now", "soma-touch.service"])
    print(subprocess.run(["systemctl", "--user", "is-active", "soma-touch.service"], capture_output=True, text=True).stdout.strip())


if __name__ == "__main__":
    if sys.argv[1:2] == ["install"]: install(); sys.exit(0)
    if sys.argv[1:2] != ["serve"]: print(__doc__.strip()); sys.exit(0)
    http.server.ThreadingHTTPServer(("127.0.0.1", PORT), H).serve_forever()

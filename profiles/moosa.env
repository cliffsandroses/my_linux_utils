# Moosa's homelab and laptop settings, as running on 2026-10-21.
# Read by homelab/*.sh and arch/post-install.sh (PROFILE=moosa is the default).
#
# NO SECRETS HERE: this repo is public. Passwords, API keys, tokens, the ntfy topic and
# SSH keys stay on the machines and in the nightly backup. Scripts read them from there.

# --- network --------------------------------------------------------------------------------
GATEWAY=192.168.10.1
LAN_CIDR=24
TIMEZONE=Asia/Kolkata
HEADSCALE_URL=https://hs.meldev.duckdns.org
HEADSCALE_USER_ID=2                       # user "moosa" in Headscale
# Split DNS for tailnet devices: these names resolve through AdGuard (home address), so the
# home-and-tailnet-only Caddy sites work away from home (2026-10-22).
HEADSCALE_SPLIT_DNS_DOMAIN=meldev.duckdns.org
HEADSCALE_SPLIT_DNS_SERVER=100.64.0.4
VM_TAILNET_IP=100.64.0.4
NEXTCLOUD_TRUSTED=("100.64.0.4:8082" "100.64.0.4")   # added to whatever config.php already trusts

# --- Proxmox (OptiPlex 3060 Micro) ----------------------------------------------------------
PVE_HOST=192.168.10.13
PVE_NODE=pve
PVE_STORAGE=local-lvm
PVE_WEB_USER=web-collector@pve            # read-only (PVEAuditor) user for the Homelab Web page

# --- the homelab VM ---------------------------------------------------------------------------
VM_ID=100
VM_NAME=Homelab
VM_HOSTNAME=homelab
VM_IP=192.168.10.20
VM_USER=moosa
VM_CORES=4
VM_MEMORY=6144
VM_ROOT_SIZE=100G
VM_SWAP_SIZE=4G                           # without swap the VM froze when RAM ran out (2026-10-21)
VM_SWAPPINESS=10
VM_CLOUD_IMAGE=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
VM_SATA_DISK=/dev/disk/by-id/ata-Geonix_GXG256V31B616155     # passed through as scsi1
VM_USB_DEVICE=0bda:9201                   # the USB enclosure of the media disk, passed through as usb0
VM_NVME_DATA_SIZE=650G                    # scsi2, a disk in local-lvm
PUID=1000
PGID=1000

# --- disks inside the VM ----------------------------------------------------------------------
DATA_UUID=dfa90c1f-d65d-4df7-a1ad-7401f5c9ed5d      # SATA, label homelab-data: backups, photos, Nextcloud copy
DATA_MNT=/mnt/data
MEDIA_UUID=96c969af-bd2a-4efa-8d7b-9b45b04a77f8     # USB 2.0 media disk
MEDIA_MNT=/mnt/media
MEDIA_ROOT=/mnt/media/DATA
NVME_LABEL=homelab-nvme                             # scsi2; formatted fresh if blank
NVME_MNT=/mnt/nvme

# --- the media pool (mergerfs) ----------------------------------------------------------------
POOL_MNT=/mnt/pool
POOL_BRANCHES="/mnt/nvme:/mnt/media/DATA=NC:/mnt/data=NC"   # new files only on nvme
POOL_OPTS="allow_other,cache.files=off,category.create=mfs,minfreespace=20G,moveonenospc=false,dropcacheonclose=true,noforget,inodecalc=path-hash,fsname=mergerfs-pool,nofail,x-systemd.requires-mounts-for=/mnt/nvme,x-systemd.requires-mounts-for=/mnt/media,x-systemd.requires-mounts-for=/mnt/data"
# Folders that must exist on the landing disk, owned by PUID, before anything writes through the pool.
POOL_LANDING_DIRS=("Downloads" "Downloads/tv-sonarr" "Downloads/radarr" "Downloads/incomplete"
  "Media" "Media/TV Shows" "Media/Movies" "Media/Shorts" "RecycleBin" "RecycleBin/sonarr" "RecycleBin/radarr")
LIB_TV="/mnt/pool/Media/TV Shows"
LIB_MOVIES="/mnt/pool/Media/Movies"
LIB_SHORTS="/mnt/pool/Media/Shorts"
DOWNLOADS="/mnt/pool/Downloads"
QBT_CONFIG=/DATA/AppData/qbittorrent/config

# --- backups ----------------------------------------------------------------------------------
BACKUP_DIR=/mnt/data/Backups/homelab
GIT_MIRRORS=/mnt/data/Backups/git-mirrors
JELLYFIN_BACKUP_GLOB="/mnt/data/Backups/homelab/pre-jellyfin-*/jellyfin-config.tar.gz"

# --- NFS exports from the VM ------------------------------------------------------------------
NFS_EXPORTS=(
  "/mnt/media/DATA 192.168.10.21(ro,sync,no_subtree_check,all_squash,anonuid=1000,anongid=1000)"
  "/mnt/data/Media 192.168.10.21(ro,sync,no_subtree_check,all_squash,anonuid=1000,anongid=1000)"
  "/mnt/data/Backups/proxmox 192.168.10.13(rw,sync,no_subtree_check,all_squash,anonuid=1000,anongid=1000)"
  "/mnt/nvme/Media 192.168.10.21(ro,sync,no_subtree_check,all_squash,anonuid=1000,anongid=1000)"
  "/mnt/pool 192.168.10.21(ro,sync,no_subtree_check,all_squash,anonuid=1000,anongid=1000,fsid=200,crossmnt)"
)

# --- apps -------------------------------------------------------------------------------------
# Start order: Caddy owns caddy_default (Vaultwarden, Headscale join it); qBittorrent before
# the arr stack (it joins qbittorrent_default). Each name is a folder in ~/homelab.
STACKS="caddy adguard vaultwarden headscale immich qbittorrent arr nextcloud homeassistant plex bazarr seerr profilarr recyclarr cleanuparr qui watchstate dashboard dockhand dozzle freellmapi ps5-mqtt watchtower netdata"
# Apps that need more memory than their compose cap for their FIRST start after a restore
# (database load, map-data import, cache build). Applied live; the next restart drops back.
FIRST_START_MEMORY="immich_postgres=2g profilarr=1g"
# Containers that mount the pool, and how.
POOL_MOUNT_STACKS="arr bazarr cleanuparr qbittorrent"
POOL_MOUNT_RO_STACKS="plex"

# --- Soma -------------------------------------------------------------------------------------
SOMA_REPO=axon-dashboard                  # its git mirror under GIT_MIRRORS
SOMA_BRANCH=work-door
SOMA_JF_ROOTS='{"/tv":"/mnt/pool/Media/TV Shows","/movies":"/mnt/pool/Media/Movies","/music":"/mnt/pool/Media/Music","/shorts":"/mnt/pool/Media/Shorts","/downloads":"/mnt/pool/Downloads"}'

# --- schedules on the VM ----------------------------------------------------------------------
CRONTAB_LINES=(
  "0 3 * * * /home/moosa/Axon/bin/nightly"
  "15 3 * * * /home/moosa/homelab/backup/backup-homelab.sh >> /home/moosa/homelab/backup/backup.log 2>&1"
  "0 */2 * * * /home/moosa/homelab/backup/offsite-retry.sh >> /home/moosa/homelab/backup/offsite-retry.log 2>&1"
)
CRON_D_QBT_GUARD="20 * * * * root /usr/bin/python3 /home/moosa/homelab/qbt-snapshots/review_unlinked.py --guard >> /home/moosa/homelab/qbt-snapshots/guard-cron.log 2>&1"
USER_TIMERS="homelab-snapshot.timer arr-missing-search.timer nextcloud-offsite.timer homelab-web.timer soma-next-build.timer"
USER_SERVICES="soma-next.service"
# Left off until what they need is back: Jellyfin's sign-in file for Soma (~/.config/soma/jellyfin.json).
USER_TIMERS_OFF="jellyfin-airing-order.timer"

# --- Proxmox containers -----------------------------------------------------------------------
DNS_FALLBACK_CT=101
DNS_FALLBACK_IP=192.168.10.10
JELLYFIN_CT=200
JELLYFIN_IP=192.168.10.21
JELLYFIN_MAC=BC:24:11:C5:A7:65
JELLYFIN_MEMORY=1536                      # it uses ~250 MB; 4096 overcommitted the 7.6 GB host
JELLYFIN_CORES=4
JELLYFIN_DISK=16
JELLYFIN_TEMPLATE=debian-12-standard
JELLYFIN_MOUNTS=(                          # NFS source on the VM -> mount point in the CT
  "/mnt/pool/Media/Movies:/movies"
  "/mnt/pool/Media/TV\\040Shows:/tv"
  "/mnt/pool/Media/Music:/music"
  "/mnt/pool/Media/Shorts:/shorts"
  "/mnt/pool/Downloads:/downloads"
)

# --- the laptop (Mak) -------------------------------------------------------------------------
LAPTOP_IP=192.168.10.30
LAPTOP_IFACE=enp2s0
LAPTOP_DNS="192.168.10.20 192.168.10.10"  # AdGuard, then the DNS fallback CT
LAPTOP_LID=ignore                         # stays on with the lid closed (KDE and logind); "suspend" to undo
